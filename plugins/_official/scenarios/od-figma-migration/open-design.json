{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "od-figma-migration",
  "title": "Figma migration (default scenario)",
  "version": "0.1.0",
  "description": "Default reference pipeline for the figma-migration taskKind.",
  "license": "MIT",
  "author": {
    "name": "Open Design",
    "url": "https://github.com/nexu-io"
  },
  "homepage": "https://github.com/nexu-io/open-design/tree/main/plugins/_official/scenarios/od-figma-migration",
  "tags": [
    "scenario",
    "first-party",
    "figma-migration",
    "phase-6"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "figma-migration",
    "scenario": "figma-migration",
    "mode": "scenario",
    "pipeline": {
      "stages": [
        {
          "id": "extract",
          "atoms": [
            "figma-extract"
          ]
        },
        {
          "id": "tokens",
          "atoms": [
            "token-map"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        },
        {
          "id": "critique",
          "atoms": [
            "critique-theater"
          ],
          "repeat": true,
          "until": "critique.score>=4 || iterations>=3"
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "network"
    ],
    "useCase": {
      "query": {
        "en": "Migrate the Figma page at {{figmaUrl}} into a {{outputFormat}} project styled with {{cssFramework}}. Extract design tokens from <cwd>/figma/tree.json and tokens.json (already written by the figma-extract stage). When componentsUrl ({{componentsUrl}}) is provided, treat that page as the project's component library: write each component to <cwd>/components/<Name>.<ext> and import them from the screens in <cwd>/pages/<Name>.<ext>. Self-critique against the design system until the score converges.",
        "zh-CN": "使用这个插件完成以下任务：Migrate the Figma page at {{figmaUrl}} into a {{outputFormat}} project styled with {{cssFramework}}. Extract design tokens from <cwd>/figma/tree.json and tokens.json. When componentsUrl ({{componentsUrl}}) is provided, treat that page as the project's component library: write each component to <cwd>/components/<Name>.<ext> and import them from the screens in <cwd>/pages/<Name>.<ext>. Self-critique against the design system until the score converges."
      },
      "exampleOutputs": [
        {
          "path": "./examples/dashboard-card.html",
          "title": "Dashboard card from Figma"
        }
      ]
    },
    "inputs": [
      {
        "name": "figmaUrl",
        "type": "string",
        "required": true,
        "label": "Figma page URL (screens)",
        "placeholder": "https://www.figma.com/design/abc/Dashboard?node-id=10-2"
      },
      {
        "name": "componentsUrl",
        "type": "string",
        "required": false,
        "label": "Figma page URL (components, optional)",
        "placeholder": "https://www.figma.com/design/abc/Dashboard?node-id=20-5"
      },
      {
        "name": "outputFormat",
        "type": "select",
        "required": true,
        "label": "Output format",
        "options": ["react", "html"],
        "default": "react"
      },
      {
        "name": "cssFramework",
        "type": "select",
        "required": true,
        "label": "CSS framework",
        "options": ["tailwind", "bootstrap"],
        "default": "tailwind"
      },
      {
        "name": "frameName",
        "type": "string",
        "required": false,
        "label": "Single frame to extract (optional)",
        "placeholder": "Dashboard / Card / Active sessions"
      }
    ]
  }
}
